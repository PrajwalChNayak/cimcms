generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model Consumer {
  id              String    @id @default(auto()) @map("_id") @db.ObjectId
  email           String    @unique
  password        String
  name            String?
  mobileNumber    String?
  profileImageUrl String?
  lastLogin       DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  farms           Farm[]
  devices         Device[]
}

model Farm {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  name       String
  address    String?
  consumerId String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  consumer   Consumer @relation(fields: [consumerId], references: [id])
  devices    Device[]
}

model Device {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  name       String
  type       String
  location   String?
  deviceId   String   @unique
  consumerId String
  farmId     String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  consumer   Consumer @relation(fields: [consumerId], references: [id])
  farm       Farm?    @relation(fields: [farmId], references: [id])
}
