{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "number",
      "const": 1
    },
    "device_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9-]{3,40}$"
    },
    "firmware_version": {
      "type": "string",
      "maxLength": 32
    },
    "timestamp_utc": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
    },
    "boot_id": {
      "type": "string",
      "maxLength": 40
    },
    "seq": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "mode": {
      "type": "string",
      "enum": [
        "MANUAL",
        "MAINTENANCE",
        "AUTO",
        "EXPERIMENT"
      ]
    },
    "mode_status": {
      "type": "string",
      "enum": [
        "ACTIVE",
        "NOT_CONFIGURED"
      ]
    },
    "simulation_mode": {
      "type": "boolean"
    },
    "connectivity": {
      "type": "object",
      "properties": {
        "wifi_connected": {
          "type": "boolean"
        },
        "ssid": {
          "type": "string",
          "maxLength": 32
        },
        "ip": {
          "type": "string",
          "maxLength": 45
        },
        "rssi_dbm": {
          "type": "integer",
          "minimum": -127,
          "maximum": 0
        },
        "mqtt_connected": {
          "type": "boolean"
        }
      },
      "required": [
        "wifi_connected",
        "mqtt_connected"
      ]
    },
    "relay_states": {
      "minItems": 16,
      "maxItems": 16,
      "type": "array",
      "items": {
        "type": "boolean"
      }
    },
    "relay_on_count": {
      "type": "integer",
      "minimum": 0,
      "maximum": 16
    },
    "rtc": {
      "type": "object",
      "properties": {
        "available": {
          "type": "boolean"
        },
        "valid": {
          "type": "boolean"
        },
        "time_utc": {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
        },
        "sync_source": {
          "type": "string",
          "maxLength": 32
        },
        "last_sync_utc": {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
        },
        "last_sync_result": {
          "type": "string",
          "maxLength": 32
        },
        "drift_ms": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        "lost_power": {
          "type": "boolean"
        }
      },
      "required": [
        "valid"
      ]
    },
    "config_version": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "auto_ready": {
      "type": "boolean"
    }
  },
  "required": [
    "schema_version",
    "device_id",
    "firmware_version",
    "timestamp_utc",
    "mode",
    "simulation_mode",
    "connectivity",
    "relay_states",
    "relay_on_count"
  ]
}
