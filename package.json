  },
  "scripts": {
     "start": "node app.js",
       "generate:prisma": "prisma generate",
       "migrate:dev:name": "prisma migrate dev --name  $NAME",
       "migrate:dev": "prisma migrate dev ",
       "db:pull": "prisma db pull",
       "db:push": "prisma db push",
       "migrate:resolve": "prisma migrate resolve --applied",
       "migrate:create-only": "prisma migrate dev --create-only",
       "docker:build": "docker build -t aqua-solve-iot .",
       "docker:run": "docker run -p 3004:3004 aqua-solve-iot",
       "docker:compose": "docker-compose up",
       "docker:compose:build": "docker-compose up --build",
       "docker:compose:down": "docker-compose down",
       "prisma:generate": "prisma generate"
  },
