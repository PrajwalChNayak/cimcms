# Copy to /opt/cimcms/secrets/broker.env on the server (OUTSIDE git, chmod 600).
# Placeholder values only. Do not wrap values in quotes (docker env_file keeps quotes literally).

# The SAME database the CIMCMS API uses (today: database bms_test on the Postgres on this server).
# From inside the broker container, use host.docker.internal:<published-port> (compose maps it to
# the host) or the server's address; never "localhost" (that is the broker container itself).
# URL-encode special characters in the password.
DATABASE_URL=postgresql://<db-user>:<db-password>@host.docker.internal:<db-port>/bms_test?schema=public

# Optional. Ports and TLS paths are set in docker-compose.yml.
# BROKER_LOG=silent
