# Copy to /opt/cimcms/secrets/broker.env on the server (OUTSIDE git, chmod 600).
# Placeholder values only. Do not wrap values in quotes (docker env_file keeps quotes literally).

# The broker's OWN database (tables MqttAccount, MqttRetained), separate from the API's database
# (today bms_test). Create it once on the same Postgres (see README "Database"); the broker
# container applies its migrations at start. The API's BROKER_DATABASE_URL must point to the same
# database. From inside the broker container, use host.docker.internal:<published-port> (compose
# maps it to the host) or the server's address; never "localhost" (that is the broker container
# itself). URL-encode special characters in the password.
BROKER_DATABASE_URL=postgresql://<db-user>:<db-password>@host.docker.internal:<db-port>/cimcms_broker?schema=public

# Optional. Ports and TLS paths are set in docker-compose.yml.
# BROKER_LOG=silent
