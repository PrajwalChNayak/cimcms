# Copy to /opt/cimcms/secrets/broker.env (outside the repo, chmod 600). Placeholder values only.
# The broker's OWN database (not the app database cimcms). Same BROKER_DATABASE_URL as api.env.
# Created by postgres-init/create-broker-db.sql; the broker container migrates it at start.
# URL-encode special characters in the password.
BROKER_DATABASE_URL=postgresql://<postgres-user>:<postgres-password>@postgres:5432/cimcms_broker?schema=public
# Ports and TLS paths are set in docker-compose.yml. BROKER_LOG=silent disables logging.
