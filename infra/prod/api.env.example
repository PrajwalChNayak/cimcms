# Copy to /opt/cimcms/secrets/api.env (outside the repo, chmod 600). Placeholder values only.
# Generate secrets with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Do not wrap values in quotes (docker env_file keeps quotes literally).

NODE_ENV=production
PORT=3814
# Must equal MAIN_ROUTE in infra/prod/.env (nginx proxies /api/ to /<MAIN_ROUTE>/)
MAIN_ROUTE=api/v1
APP_BASE_URL=https://<domain>
API_DOCS_ENABLED=false

JWT_SECRET_KEY=<generate-random-value>
SESSION_SECRET_KEY=<generate-random-value>

# Same user/password/db as postgres.env; URL-encode special characters in the password.
DATABASE_URL=postgresql://<postgres-user>:<postgres-password>@postgres:5432/cimcms?schema=public
DB_DIALECT=postgresql

ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=7
REFRESH_COOKIE_NAME=cimcms_rt
# Path the BROWSER sees (nginx maps /api/ -> /<MAIN_ROUTE>/)
REFRESH_COOKIE_PATH=/api/user/token

# MQTT: own broker (service "broker" in docker-compose.yml, docs/runbooks/broker.md).
# Inside compose the API talks to it over the private network, so plain mqtt:// is fine here.
MQTT_URL=mqtt://broker:1883
# Service login, created with: docker compose exec api node dist/src/models/mqtt-account.js --username cimcms-backend --kind service
MQTT_USERNAME=cimcms-backend
MQTT_PASSWORD=<backend-mqtt-password>
# Must differ from dev: the broker disconnects an older client with the same id.
MQTT_CLIENT_ID=cimcms-backend
# Only needed when the broker certificate is not publicly trusted; path INSIDE the container.
MQTT_CA_FILE=
MONITOR_HUMIDIFIER=true

# Device broker accounts.
#   broker (default): the API creates, resets and deletes device logins in table MqttAccount
#                     (Devices -> Add device); the own broker reads them from the database.
#   manual:           external broker (for example Mosquitto); an operator creates each device
#                     account there and the web app shows the manual steps.
MQTT_PROVISIONING=broker
# Public broker address that devices use; the web app shows it with each device account.
# Use the host name on the broker certificate (for example mqtt.<domain>), TLS port 8883.
MQTT_DEVICE_URL=mqtts://<broker-host>:8883

# Password hashing (Argon2id)
ARGON2_MEMORY_COST=65536
ARGON2_TIME_COST=3
ARGON2_PARALLELISM=1
ARGON2_HASH_LENGTH=32

# Mail (leave unset/placeholder if mail features are unused)
MAIL_DRIVER=smtp
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=<mail-user>
MAIL_PASSWORD=<mail-password>

# Object storage omitted (minio not deployed; plan default).
# Only for `seed:admin` (min 12 chars). Add temporarily, run the seed, then REMOVE it from this file.
# BOOTSTRAP_ADMIN_PASSWORD=<min-12-chars>
SEED_DEVICES=LED-01:LED_CONTROLLER:LED Controller 1
