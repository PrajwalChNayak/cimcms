# Copy to infra/prod/.env (git-ignored). Non-secret deployment parameters only.
DOMAIN=cims.example.org
# Image tag for cimcms-api, cimcms-web and cimcms-broker (rollback = previous tag)
CIMCMS_TAG=local
# Must equal MAIN_ROUTE in api.env
MAIN_ROUTE=api/v1
# Optional overrides (defaults shown)
# CIMCMS_SECRETS_DIR=/opt/cimcms/secrets
# LETSENCRYPT_DIR=/etc/letsencrypt
# CERTBOT_WEBROOT=/var/www/certbot
# Host name on the MQTT TLS certificate (folder under /etc/letsencrypt/live); default DOMAIN
# MQTT_DOMAIN=mqtt.cims.example.org
