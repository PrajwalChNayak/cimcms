# Root build context for apps/api, apps/web and apps/broker images (docker build -f apps/<app>/Dockerfile .)
# apps/broker needs apps/api/src/models/tables/schema.prisma (shared Prisma schema): keep apps/api.
.git
**/node_modules
**/dist
**/coverage
**/.env
**/.env.*
!**/.env.example
**/*.local
infra/dev
infra/server-*
docs
tools/**
!tools/*/package.json
**/playwright-report
**/test-results
