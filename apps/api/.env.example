# Copy to .env (git-ignored) and fill in. Placeholder values only.

# Runtime
NODE_ENV=development
PORT=3814
MAIN_ROUTE=api/v1

# Secrets (generate random values, e.g. node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))")
JWT_SECRET_KEY=<generate-random-value>
SESSION_SECRET_KEY=<generate-random-value>

# Database (PostgreSQL; dev container from infra/dev/docker-compose.yml, port 5433)
# Apply migrations with: npm run db:deploy -w apps/api   (or db:migrate while changing the schema)
DATABASE_URL=postgresql://cimcms:cimcms_dev_only@localhost:5433/cimcms?schema=public
# Broker database (tables MqttAccount, MqttRetained), separate from DATABASE_URL. The API writes
# device logins there; the broker (apps/broker/.env) uses the same value. Create it once
# (CREATE DATABASE cimcms_broker) and migrate it with: npm run db:deploy -w @cimcms/broker
BROKER_DATABASE_URL=postgresql://cimcms:cimcms_dev_only@localhost:5433/cimcms_broker?schema=public
DB_DIALECT=postgresql

# Mail
MAIL_DRIVER=smtp
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=<mail-user>
MAIL_PASSWORD=<mail-password>

# Object storage (MinIO / S3)
CLOUD_ENDPOINT=localhost
CLOUD_PORT=9000
CLOUD_USE_SSL=false
CLOUD_ACCESS_KEY=<access-key>
CLOUD_SECRET_KEY=<secret-key>
CLOUD_BUCKET_NAME=<bucket>
USER_FOLDER=users

# Uploads
MAX_FILE_SIZE=5242880
ALLOWED_EXTENSIONS=jpg,jpeg,png,pdf

# Password hashing (Argon2id)
ARGON2_MEMORY_COST=65536
ARGON2_TIME_COST=3
ARGON2_PARALLELISM=1
ARGON2_HASH_LENGTH=32

# --- CIMCMS additions ---
APP_BASE_URL=http://localhost:5173
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=7
REFRESH_COOKIE_NAME=cimcms_rt
# Must equal the path the BROWSER sees for /user/token/*. Same-origin (D-6): Nginx and the Vite proxy map /api/* to /<MAIN_ROUTE>/*, so this is /api/user/token.
REFRESH_COOKIE_PATH=/api/user/token
MQTT_URL=mqtt://localhost:1883
MQTT_USERNAME=cimcms-backend
MQTT_PASSWORD=<dev-only-value>
# Must differ between dev and prod: the broker disconnects an older client with the same id.
MQTT_CLIENT_ID=cimcms-backend-dev
MQTT_CA_FILE=
# Device broker accounts. Broker logins live in the CIMCMS database (MqttAccount table); the
# CIMCMS broker (apps/broker) checks it on every connect.
#   broker (default): the API creates, resets and deletes each device's account when the device
#                     is registered, gets a new password, or is deleted.
#   manual:           the API does not create device accounts; create them with
#                     `npm run mqtt:account -- --username <deviceId> --kind device --device-type <TYPE>`.
# Service accounts (like MQTT_USERNAME above) are always created with `npm run mqtt:account`.
MQTT_PROVISIONING=broker
# Broker address that devices use; the web app shows it with each device account.
# Use your PC's LAN IP so a real device on your network can reach the dev broker.
MQTT_DEVICE_URL=mqtt://<your-PC-LAN-IP>:1883
MONITOR_HUMIDIFIER=true
API_DOCS_ENABLED=true
# Used only by `npm run seed:admin` (min 12 chars). Set in your local .env; never commit a real value.
BOOTSTRAP_ADMIN_PASSWORD=<min-12-chars-placeholder>
SEED_DEVICES=LED-01:LED_CONTROLLER:LED Controller 1
