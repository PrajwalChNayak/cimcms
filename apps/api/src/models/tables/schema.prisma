generator client {
  provider = "prisma-client-js"
}

// PostgreSQL (owner decision O-1, 2026-11-22). Schema changes go through migrations:
//   npm run db:migrate -w apps/api   (dev: creates a migration in ./migrations)
//   npm run db:deploy  -w apps/api   (staging/prod: applies pending migrations)
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String         @id @default(uuid()) @db.Uuid
  email         String         @unique
  password      String
  name          String?
  status        CommonStatus   @default(ACTIVE)
  roles         UserRole[]
  refreshTokens RefreshToken[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
}

model Role {
  id          String           @id @default(uuid()) @db.Uuid
  name        String           @unique
  status      CommonStatus     @default(ACTIVE)
  isSystem    Boolean          @default(false)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  users       UserRole[]
  permissions RolePermission[]
}

model Permission {
  id        String           @id @default(uuid()) @db.Uuid
  name      String           @unique
  status    CommonStatus     @default(ACTIVE)
  isSystem  Boolean          @default(false)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  roles     RolePermission[]
}

// Junction model for User <-> Role
model UserRole {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  roleId    String   @db.Uuid
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
  @@index([roleId])
}

// Junction model for Role <-> Permission
model RolePermission {
  id           String     @id @default(uuid()) @db.Uuid
  roleId       String     @db.Uuid
  permissionId String     @db.Uuid
  createdAt    DateTime   @default(now())
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@index([permissionId])
}

model Consumer {
  id              String    @id @default(uuid()) @db.Uuid
  email           String    @unique
  password        String
  name            String?
  mobileNumber    String?
  profileImageUrl String?
  lastLogin       DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  farms           Farm[]
  devices         Device[]
}

model Farm {
  id         String   @id @default(uuid()) @db.Uuid
  name       String
  address    String?
  consumerId String   @db.Uuid
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  consumer   Consumer @relation(fields: [consumerId], references: [id])
  devices    Device[]

  @@index([consumerId])
}

model Device {
  id         String    @id @default(uuid()) @db.Uuid
  name       String?
  type       String?
  location   String?
  deviceId   String    @unique
  deviceType String
  consumerId String?   @db.Uuid
  farmId     String?   @db.Uuid
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  consumer   Consumer? @relation(fields: [consumerId], references: [id], onDelete: SetNull)
  farm       Farm?     @relation(fields: [farmId], references: [id], onDelete: SetNull)

  @@index([consumerId])
  @@index([farmId])
}

model MasterTypeConstant {
  id        String   @id @default(uuid()) @db.Uuid
  type      String
  value     String
  info      Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([type])
}

enum CommonStatus {
  ACTIVE
  INACTIVE
  DELETED
  BLOCK
}

// ─── CIMCMS device platform (plan section 6) ─────────────────────────────────
// Operational tables reference devices by the physical `deviceId` (D-8) without a foreign key,
// so history (commands, events, audit) survives when a device record is deleted.
enum Liveness {
  UNKNOWN
  ONLINE
  STALE
  OFFLINE
}

enum CommandStatus {
  PENDING
  PUBLISHED
  ACCEPTED
  EXECUTED
  REJECTED
  EXPIRED
  DUPLICATE
  FAILED
  TIMEOUT
  PUBLISH_FAILED
}

model DeviceStatus {
  id              String    @id @default(uuid()) @db.Uuid
  deviceId        String    @unique
  type            String
  liveness        Liveness  @default(UNKNOWN)
  lastSeenAt      DateTime?
  lastStatusAt    DateTime?
  lastTelemetryAt DateTime?
  firmwareVersion String?
  bootId          String?
  lastSeq         Int?
  mode            String?
  modeStatus      String?
  simulationMode  Boolean?
  relayStates     Boolean[]
  relayOnCount    Int       @default(0)
  connectivity    Json?
  rtc             Json?
  configVersion   Int?
  autoReady       Boolean?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([liveness, lastSeenAt])
}

// Telemetry history (was a MongoDB time-series collection). Retention: RetentionJob.
model Telemetry {
  id             BigInt    @id @default(autoincrement())
  ts             DateTime
  deviceId       String
  type           String
  mode           String?
  simulationMode Boolean?
  relayStates    Boolean[]
  relayOnCount   Int?
  rssiDbm        Int?
  wifiConnected  Boolean?
  mqttConnected  Boolean?
  rtcValid       Boolean?
  seq            Int?
  bootId         String?

  @@index([deviceId, ts])
  @@index([ts])
}

model Command {
  id             String        @id @default(uuid()) @db.Uuid
  commandId      String        @unique // UUID on the wire
  idempotencyKey String        @unique // client header value, or = commandId
  deviceId       String
  action         String
  params         Json
  source         String // web | schedule | experiment | system
  issuedById     String?       @db.Uuid
  issuedByEmail  String?
  requestId      String?
  status         CommandStatus @default(PENDING)
  reason         String?
  lateResult     String? // device result that arrived after TIMEOUT
  issuedAt       DateTime
  expiresAt      DateTime
  publishedAt    DateTime?
  completedAt    DateTime?
  simulation     Boolean?
  acks           CommandAck[]
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([deviceId, issuedAt])
  @@index([status, expiresAt])
  @@index([deviceId, status, completedAt])
  @@index([issuedAt])
}

// Device acknowledgements of a command, in arrival order (id).
model CommandAck {
  id            Int       @id @default(autoincrement())
  commandId     String
  result        String
  reason        String?
  reportedState String?
  receivedAt    DateTime
  deviceTs      DateTime?
  command       Command   @relation(fields: [commandId], references: [commandId], onDelete: Cascade)

  @@index([commandId])
}

model DeviceEvent {
  id         String    @id @default(uuid()) @db.Uuid
  deviceId   String
  type       String // DEVICE_EVENT_TYPES or BACKEND_EVENT_TYPES
  origin     String // DEVICE | BACKEND
  data       Json
  deviceTs   DateTime?
  receivedAt DateTime  @default(now())

  @@index([deviceId, receivedAt])
  @@index([type, receivedAt])
  @@index([receivedAt])
}

model RelayStateChange {
  id         String   @id @default(uuid()) @db.Uuid
  deviceId   String
  relay      Int
  state      Boolean
  source     String // RELAY_CHANGE_SOURCES
  commandId  String?
  simulation Boolean
  at         DateTime

  @@index([deviceId, relay, at])
  @@index([at])
}

model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  actorId    String?  @db.Uuid
  actorEmail String?
  actorType  String // USER | SYSTEM
  action     String // LOGIN_SUCCEEDED, LOGIN_FAILED, COMMAND_SUBMITTED, ...
  entity     String
  entityId   String?
  data       Json? // never passwords, tokens, secrets
  ip         String?
  requestId  String?
  at         DateTime @default(now())

  @@index([at])
  @@index([actorId, at])
  @@index([entity, entityId])
}

model RefreshToken {
  id             String    @id @default(uuid()) @db.Uuid
  userId         String    @db.Uuid
  tokenHash      String    @unique // sha256 hex of the opaque cookie value
  familyId       String
  expiresAt      DateTime
  revokedAt      DateTime?
  replacedByHash String?
  userAgent      String?
  ip             String?
  createdAt      DateTime  @default(now())
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
  @@index([expiresAt])
}

// ─── CIMCMS Phase 5: rooms, schedules, device config, experiments (plan T5.1-T5.4) ───
enum RoomStatus {
  ACTIVE
  INACTIVE
}

enum ScheduleStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum DeviceConfigStatus {
  PUBLISHED
  APPLIED
  REJECTED
}

enum ExperimentStatus {
  DRAFT
  READY
  RUNNING
  PAUSED
  COMPLETED
  STOPPED
}

model Room {
  id        String                  @id @default(uuid()) @db.Uuid
  farmId    String?                 @db.Uuid
  code      String                  @unique
  name      String
  status    RoomStatus              @default(ACTIVE)
  notes     String?
  createdAt DateTime                @default(now())
  updatedAt DateTime                @updatedAt
  channels  RoomChannelAssignment[]
  schedules Schedule[]
}

// The unique index prevents one relay in two rooms (FRS 9.4).
model RoomChannelAssignment {
  id        String   @id @default(uuid()) @db.Uuid
  roomId    String   @db.Uuid
  deviceId  String
  relay     Int
  label     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  room      Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@unique([deviceId, relay])
  @@index([roomId])
}

model Schedule {
  id               String            @id @default(uuid()) @db.Uuid
  roomId           String            @db.Uuid
  name             String
  status           ScheduleStatus    @default(DRAFT)
  latestVersion    Int               @default(1)
  publishedVersion Int?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  room             Room              @relation(fields: [roomId], references: [id])
  versions         ScheduleVersion[]

  @@index([roomId])
}

// Immutable once publishedAt is set. effectiveFrom/effectiveTo are IST calendar days (YYYY-MM-DD).
model ScheduleVersion {
  id             String    @id @default(uuid()) @db.Uuid
  scheduleId     String    @db.Uuid
  version        Int
  rules          Json
  effectiveFrom  String
  effectiveTo    String?
  createdById    String?   @db.Uuid
  createdByEmail String?
  publishedAt    DateTime?
  createdAt      DateTime  @default(now())
  schedule       Schedule  @relation(fields: [scheduleId], references: [id], onDelete: Cascade)

  @@unique([scheduleId, version])
}

model DeviceConfig {
  id             String             @id @default(uuid()) @db.Uuid
  deviceId       String
  configVersion  Int
  payload        Json
  sourceVersions Json
  status         DeviceConfigStatus @default(PUBLISHED)
  publishedAt    DateTime
  appliedAt      DateTime?
  reason         String?
  createdAt      DateTime           @default(now())

  @@unique([deviceId, configVersion])
}

model Experiment {
  id             String                 @id @default(uuid()) @db.Uuid
  code           String                 @unique
  title          String
  description    String?
  status         ExperimentStatus       @default(DRAFT)
  startsAt       DateTime
  endsAt         DateTime
  createdById    String?                @db.Uuid
  createdByEmail String?
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt
  assignments    ExperimentAssignment[]

  @@index([status])
}

model ExperimentAssignment {
  id           String     @id @default(uuid()) @db.Uuid
  experimentId String     @db.Uuid
  groupLabel   String
  deviceId     String
  relay        Int
  windows      Json
  experiment   Experiment @relation(fields: [experimentId], references: [id], onDelete: Cascade)

  @@index([experimentId])
  @@index([deviceId, relay])
}

// Broker logins and retained messages live in the broker database (apps/broker/prisma).
