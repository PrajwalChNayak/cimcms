# CIMCMS MQTT broker (apps/broker). Copy to apps/broker/.env for `npm run dev:broker`.
# Placeholder values only. Never commit the real file.

# The broker's OWN database (NOT the API's DATABASE_URL). The broker reads logins from table
# MqttAccount and stores retained messages in MqttRetained. Create the database once
# (CREATE DATABASE cimcms_broker), then apply the broker migrations:
#   npm run db:deploy -w @cimcms/broker      (db:migrate while changing apps/broker/prisma/schema.prisma)
# apps/api/.env BROKER_DATABASE_URL must have the same value (the API writes device logins).
BROKER_DATABASE_URL=postgresql://<db-user>:<db-password>@<db-host>:5432/cimcms_broker?schema=public

# Plain MQTT listener
BROKER_PORT=1883

# MQTTS listener: started only when BOTH cert and key are set (PEM files).
BROKER_TLS_PORT=8883
BROKER_TLS_CERT=
BROKER_TLS_KEY=

# HTTP health check: GET http://<host>:<port>/health
BROKER_HEALTH_PORT=8081

# silent = no log output (tests). Leave empty for normal JSON logs.
BROKER_LOG=
