# CIMCMS MQTT broker (apps/broker). Copy to apps/broker/.env for `npm run dev:broker`.
# Placeholder values only. Never commit the real file.

# Same database as the API (apps/api/.env DATABASE_URL). The broker reads logins from table
# MqttAccount and stores retained messages in MqttRetained. It never runs migrations:
# apply them with `npm run db:deploy -w apps/api` first.
DATABASE_URL=postgresql://<db-user>:<db-password>@<db-host>:5432/<db-name>?schema=public

# Plain MQTT listener
BROKER_PORT=1883

# MQTTS listener: started only when BOTH cert and key are set (PEM files).
BROKER_TLS_PORT=8883
BROKER_TLS_CERT=
BROKER_TLS_KEY=

# HTTP health check: GET http://<host>:<port>/health
BROKER_HEALTH_PORT=8081

# silent = no log output (tests). Leave empty for normal JSON logs.
BROKER_LOG=
