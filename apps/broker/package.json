{
  "name": "@cimcms/broker",
  "version": "0.1.0",
  "private": true,
  "description": "CIMCMS MQTT broker (aedes): logins and topic permissions from the CIMCMS PostgreSQL database",
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "start": "node dist/main.js",
    "build": "tsup",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@cimcms/contracts": "*",
    "@prisma/client": "^6.10.1",
    "aedes": "^1.2.0",
    "argon2": "^0.44.0",
    "dotenv": "^16.4.7"
  },
  "devDependencies": {
    "@types/node": "^25.5.0",
    "embedded-postgres": "^16.16.0-beta.19",
    "mqtt": "^5.16.1",
    "tsup": "^8.5.1",
    "tsx": "^4.21.0",
    "typescript": "~5.9.3",
    "vitest": "^5.1.1"
  }
}
