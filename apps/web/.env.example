# Same-origin API base (Vite dev proxy / Nginx forward /api to the API)
VITE_API_BASE_URL=/api
# Socket.IO path (optional, default /socket.io)
# VITE_SOCKET_PATH=/socket.io

# CIMCMS dashboard + navigation (true) or the old farm/consumer dashboard (false/unset)
VITE_FF_CIMCMS=true

# --- dev server proxy targets (read by vite.config.ts, not exposed to the browser) ---
# API_PORT must match PORT in apps/api/.env; MAIN_ROUTE must match MAIN_ROUTE there.
API_PORT=3814
MAIN_ROUTE=api/v1
