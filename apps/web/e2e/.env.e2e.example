# Copy to e2e/.env.e2e (git-ignored). If the file is missing, the e2e setup generates it
# with random passwords. Placeholder values only; never commit real ones.
E2E_ADMIN_PASSWORD=<min-12-chars-random>
E2E_VIEWER_PASSWORD=<min-12-chars-random>
E2E_TECH_PASSWORD=<min-12-chars-random>
# Optional overrides
# E2E_API_PORT=3914
# E2E_WEB_PORT=5273
# E2E_DB_NAME=cimcms_e2e
# Dev broker credentials are read from infra/dev/.dev-credentials.local (git-ignored), or from
# MQTT_BACKEND_USER/MQTT_BACKEND_PASSWORD/MQTT_LED01_USER/MQTT_LED01_PASSWORD in the environment (CI).
